# Environment for `npm run preview:local`
#
# `vite build --mode preview` loads this file instead of .env.production,
# so the minified production bundle talks to the LOCAL backend
# (http://localhost:5000). The local backend's CORS_ORIGIN
# (backend/.env.development) includes http://localhost:4173.
#
# Build/serve matrix:
#   npm run dev            -> .env.development -> http://localhost:5000
#   npm run preview:local  -> .env.preview     -> http://localhost:5000
#   npm run preview:remote -> .env.production  -> https://cliqo-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000
VITE_BASE_URL=http://localhost:5000
